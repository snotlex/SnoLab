rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny is intentional. Every collection must opt in explicitly.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.admin == true
        && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMixDesign(data) {
      return data.keys().hasAll(['ownerId', 'name', 'inputs', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 256
        && data.inputs is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().size() <= 7;
    }

    function isValidMaterial(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'category', 'status', 'ApprovalStatus'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 256
        && data.category is string && data.category.size() > 0 && data.category.size() <= 128
        && data.status is string && data.status.size() <= 128
        && data.ApprovalStatus is string && data.ApprovalStatus.size() <= 128;
    }

    function isValidEmailLog(data) {
      return data.keys().hasAll(['userId', 'email', 'deliveryStatus', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.deliveryStatus is string && data.deliveryStatus.size() <= 32
        && data.createdAt is timestamp;
    }

    match /user_mixes/{mixId} {
      allow get: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && isValidId(mixId)
        && isValidMixDesign(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(mixId)
        && isValidMixDesign(incoming())
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isSignedIn()
        && isValidId(mixId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /user_materials/{materialId} {
      allow get: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && isValidId(materialId)
        && isValidMaterial(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().ApprovalStatus in ['Draft', 'Pending Review', 'Under Review', 'Incomplete']
        && incoming().status in ['نشط', 'قيد المراجعة', 'موقوف'];

      allow update: if isSignedIn()
        && isValidId(materialId)
        && isValidMaterial(incoming())
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().ownerId == existing().ownerId
        && (
          isAdmin()
          || (
            incoming().ApprovalStatus == existing().ApprovalStatus
            && incoming().status == existing().status
            && incoming().get('approvedBy', null) == existing().get('approvedBy', null)
            && incoming().get('approvedAt', null) == existing().get('approvedAt', null)
            && incoming().get('approvalNotes', null) == existing().get('approvalNotes', null)
          )
        );

      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email
        && incoming().activated == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !incoming().keys().hasAny(['role', 'isAdmin']);

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && incoming().uid == existing().uid
          && incoming().email == existing().email
          && incoming().activated == existing().activated
          && incoming().createdAt == existing().createdAt
          && incoming().keys().hasAny(['updatedAt'])
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt', 'activatedEmailSent', 'materialsSeeded'])
        );

      allow delete: if isAdmin();
    }

    match /email_logs/{logId} {
      allow read, list: if isAdmin() && isValidId(logId);
      allow create: if isAdmin() && isValidId(logId) && isValidEmailLog(incoming());
      allow update, delete: if false;
    }
  }
}
