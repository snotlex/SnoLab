# SNO Engineering AI - Environment Configuration Definitions
PORT=3000
NODE_ENV=development

# GEMINI_API_KEY: Required for SNO AI core advisor features
GEMINI_API_KEY=

# SMTP Gmail Email Configuration
SMTP_EMAIL=
SMTP_PASSWORD=

# Gemini Model Definitions (Optional customization)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash
