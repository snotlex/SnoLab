# SNO Engineering AI - Environment Configuration Definitions
PORT=3000
NODE_ENV=development

# Required for every /api/admin/* endpoint. Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=
# Explicit public URL used in activation emails and phone QR download links.
# Development may use http://localhost:3000; production MUST use a public HTTPS URL.
PUBLIC_APP_URL=http://localhost:3000
# HMAC secret used to sign report-download tokens. Generate with: openssl rand -hex 32
# Keep this value private and stable across deployments.
REPORT_DOWNLOAD_SECRET=
# Report-download link lifetime in milliseconds (default: 7 days).
REPORT_DOWNLOAD_TTL_MS=604800000

# GEMINI_API_KEY: Optional key for SNO AI core advisor features
GEMINI_API_KEY=

# SMTP Gmail Email Configuration
SMTP_EMAIL=
SMTP_PASSWORD=

# Gemini Model Definitions (Optional customization)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash
